# RunProof V2 后端 REST API 基地址（留空则走本地 /api 代理或直连 Monad Testnet RPC）
# VITE_API_BASE_URL=http://127.0.0.1:3000

# 本地 Vite 开发服务器 /api 反向代理目标（默认转发至 127.0.0.1:3000）
VITE_PROXY_TARGET=http://127.0.0.1:3000

# Monad Testnet (Chain ID 10143) RPC 节点（可选覆盖默认公共 RPC）
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
