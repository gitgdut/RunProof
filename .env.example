# API data source: mock (zero-setup demo) or prisma (PostgreSQL)
DATA_MODE=mock
DATABASE_URL=postgresql://runproof:runproof@localhost:5432/runproof?schema=public

# Monad Testnet deployment (contracts/core @ 2ba9e3a)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
RUNPROOF_CORE_ADDRESS=0x606717FC7055B81C4290b34F9cA1E8123416b0Ab
CHEAT_REGISTRY_ADDRESS=0xc0df0A2342557D42D35F34913EDB28E0792Ff400
GAME_REGISTRY_ADDRESS=0x9906867e359F1C7d609f89f39beD4b15023601B0
RECORD_NFT_ADDRESS=0x2bFb2e522e51A458b6317343ea6Ef8A5E454c6EE
# Deployed by contracts/core: first block with events is 81498746 (0x4db927a).
# INDEXER_BATCH_SIZE must respect the RPC eth_getLogs range limit; the public
# testnet RPC rejects windows above ~100 blocks. The indexer halves the window
# automatically if a batch is rejected, but starting at 100 avoids the warnings.
INDEXER_START_BLOCK=81498746
INDEXER_BATCH_SIZE=100
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_RECONCILE_LIMIT=50
INDEXER_VERIFY_LOOKBACK=1000

# API security
AUTH_MAX_SIGNATURE_AGE_SECONDS=300
CHEAT_REGISTRY_ADMIN_ADDRESSES=0xa00000000000000000000000000000000000000a
