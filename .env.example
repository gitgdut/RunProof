# API data source: mock (zero-setup demo) or prisma (PostgreSQL)
DATA_MODE=mock
DATABASE_URL=postgresql://runproof:runproof@localhost:5432/runproof?schema=public

# Monad / contract indexer (replace after contract deployment)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
RUNPROOF_CONTRACT_ADDRESS=
INDEXER_START_BLOCK=0
INDEXER_BATCH_SIZE=500
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_VERIFY_LOOKBACK=1000

# API security
AUTH_MAX_SIGNATURE_AGE_SECONDS=300
CHALLENGE_WINDOW_HOURS=48
CHEAT_REGISTRY_ADMIN_ADDRESSES=0xa00000000000000000000000000000000000000a
