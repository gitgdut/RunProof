# Copy to .env or .env.local (both git-ignored). NEVER commit a real key.

# Foundry deployment only. The web/API services never sign transactions.
PRIVATE_KEY=

# API data source: mock (zero-setup demo) or prisma (PostgreSQL)
DATA_MODE=mock
DATABASE_URL=postgresql://runproof:runproof@localhost:5432/runproof?schema=public

# Monad Testnet V2 deployment (Category / Division / ChallengeReason model).
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
RUNPROOF_CORE_ADDRESS=0x1eb96bf618151adA2F7174CE9b8c41F45486084F
CATEGORY_REGISTRY_ADDRESS=0x8D3aEdd92fA2151F61877D0e844a556E4eAB91A7
CHALLENGE_REASON_REGISTRY_ADDRESS=0x522d2883FA6ac437F414874B9B7cEEAfAE4caC0b
RECORD_NFT_ADDRESS=0x967D0B53cb05BC9D6c85BEB087444e6f5a3e1360

# First block with V2 events. Do not start from 0.
# The public RPC accepts only short eth_getLogs windows; the indexer also backs off automatically.
INDEXER_START_BLOCK=81509823
INDEXER_BATCH_SIZE=100
INDEXER_CONFIRMATIONS=5
INDEXER_POLL_INTERVAL_MS=5000
INDEXER_RECONCILE_LIMIT=50
INDEXER_VERIFY_LOOKBACK=1000
