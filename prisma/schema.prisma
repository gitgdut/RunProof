generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  PENDING
  PROVISIONAL
  VERIFIED
  REVOKED
}

enum CheatStatus {
  ACTIVE
  INACTIVE
}

enum ChallengeStatus {
  PENDING
  VOTING
  EVIDENCE_VOTING
  CONFIRMED
  DENIED
  INCONCLUSIVE
}

enum Choice {
  CONFIRM
  DENY
}

enum RewardType {
  CHALLENGER_REWARD
  PLAYER_COMPENSATION
  VOTER_REWARD
}

enum StakeFlowType {
  RETURNED
  SLASHED
}

enum StakeKind {
  PLAYER_STAKE
  CHALLENGE_BOND
  VOTER_STAKE
}

enum NFTStatus {
  PROVISIONAL
  VERIFIED
  REVOKED
}

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  createdAt     DateTime @default(now())
  records       Record[] @relation("RecordPlayer")
}

model Game {
  id          Int        @id
  name        String
  gameVersion Int        @default(0)
  ruleVersion Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  modes       GameMode[]
  records     Record[]
  cheats      Cheat[]
}

model GameMode {
  gameId    Int
  modeId    Int
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, modeId])
  @@map("game_modes")
}

model Cheat {
  id                Int         @id
  cheatCode         String      @unique
  name              String
  description       String?
  evidenceURI       String?
  discovererAddress String?
  status            CheatStatus @default(ACTIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  gameId            Int?
  game              Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)
  challenges        Challenge[]

  @@index([status])
  @@map("cheats")
}

model Record {
  id                Int          @id
  playerAddress     String
  gameId            Int
  gameMode          Int
  score             BigInt
  stakeAmount       Decimal      @db.Decimal(78, 0)
  evidenceHash      String       @unique
  evidenceURI       String
  status            RecordStatus @default(PENDING)
  submittedAt       DateTime
  challengeDeadline DateTime
  gameVersion       Int          @default(0)
  ruleVersion       Int          @default(0)
  stakeSettled      Boolean      @default(false)
  activeChallenges  Int          @default(0)
  transactionHash   String       @unique
  logIndex          Int          @default(0)
  blockNumber       BigInt?
  indexedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  player            User         @relation("RecordPlayer", fields: [playerAddress], references: [walletAddress], onDelete: Restrict)
  game              Game         @relation(fields: [gameId], references: [id], onDelete: Restrict)
  challenges        Challenge[]
  nft               NFT?
  rewards           Reward[]
  stakeFlows        StakeFlow[]

  @@index([gameId, gameMode, status, score])
  @@index([playerAddress, submittedAt])
  @@map("records")
}

model Challenge {
  id              Int              @id
  recordId        Int
  cheatId         Int
  challenger      String
  bond            Decimal          @db.Decimal(78, 0)
  reserved        Decimal          @default(0) @db.Decimal(78, 0)
  evidenceHash    String           @unique
  evidenceURI     String
  status          ChallengeStatus  @default(PENDING)
  round           Int              @default(0)
  special         Boolean          @default(false)
  extended        Boolean          @default(false)
  evidenceCount   Int              @default(0)
  createdAt       DateTime
  transactionHash String           @unique
  logIndex        Int              @default(0)
  blockNumber     BigInt?
  indexedAt       DateTime?
  record          Record           @relation(fields: [recordId], references: [id], onDelete: Cascade)
  cheat           Cheat            @relation(fields: [cheatId], references: [id], onDelete: Restrict)
  rounds          ChallengeRound[]
  votes           Vote[]
  evidence        Evidence[]

  @@index([status, createdAt])
  @@index([recordId, cheatId])
  @@index([challenger, createdAt])
  @@map("challenges")
}

model ChallengeRound {
  challengeId     Int
  round           Int
  commitEnd       DateTime?
  revealEnd       DateTime?
  confirmPower    BigInt    @default(0)
  denyPower       BigInt    @default(0)
  confirmStake    Decimal   @default(0) @db.Decimal(78, 0)
  denyStake       Decimal   @default(0) @db.Decimal(78, 0)
  committedStake  Decimal   @default(0) @db.Decimal(78, 0)
  committedVoters Int       @default(0)
  revealedVoters  Int       @default(0)
  finalized       Boolean   @default(false)
  winner          Choice?
  winnerPower     BigInt    @default(0)
  rewardPool      Decimal   @default(0) @db.Decimal(78, 0)
  slashBps        Int       @default(0)
  updatedAt       DateTime  @updatedAt
  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([challengeId, round])
  @@map("challenge_rounds")
}

model Vote {
  id                    String    @id @default(cuid())
  challengeId           Int
  voterAddress          String
  round                 Int
  votingChoice          Choice?
  stakeAmount           Decimal   @db.Decimal(78, 0)
  votingPower           BigInt?
  commitHash            String?
  commitTransactionHash String?
  revealTransactionHash String?
  revealed              Boolean   @default(false)
  claimed               Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  challenge             Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, round, voterAddress])
  @@index([voterAddress, createdAt])
  @@index([commitTransactionHash])
  @@map("votes")
}

model Evidence {
  id              String    @id @default(cuid())
  challengeId     Int
  round           Int
  submitter       String
  evidenceHash    String
  evidenceURI     String
  transactionHash String
  logIndex        Int
  blockNumber     BigInt?
  createdAt       DateTime
  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([transactionHash, logIndex])
  @@index([challengeId, round])
  @@map("evidence")
}

model Reward {
  id              String     @id @default(cuid())
  recordId        Int?
  cheatId         Int?
  challengeId     Int?
  walletAddress   String
  amount          Decimal    @db.Decimal(78, 0)
  rewardType      RewardType
  transactionHash String
  logIndex        Int
  blockNumber     BigInt?
  createdAt       DateTime
  record          Record?    @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@unique([transactionHash, logIndex])
  @@index([walletAddress, createdAt])
  @@index([recordId])
  @@map("rewards")
}

model StakeFlow {
  id              String        @id @default(cuid())
  recordId        Int?
  cheatId         Int?
  challengeId     Int?
  walletAddress   String
  amount          Decimal       @db.Decimal(78, 0)
  flowType        StakeFlowType
  stakeKind       StakeKind
  transactionHash String
  logIndex        Int
  blockNumber     BigInt?
  createdAt       DateTime
  record          Record?       @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@unique([transactionHash, logIndex])
  @@index([walletAddress, createdAt])
  @@map("stake_flows")
}

model NFT {
  id              Int       @id
  recordId        Int       @unique
  ownerAddress    String
  status          NFTStatus
  transactionHash String
  logIndex        Int
  createdAt       DateTime
  updatedAt       DateTime  @updatedAt
  record          Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([ownerAddress, status])
  @@map("nfts")
}

model ChainEventLog {
  id              String   @id @default(cuid())
  chainId         Int
  contractAddress String
  source          String
  eventName       String
  transactionHash String
  logIndex        Int
  blockNumber     BigInt
  blockHash       String
  payload         Json
  processedAt     DateTime @default(now())

  @@unique([chainId, transactionHash, logIndex])
  @@index([contractAddress, blockNumber])
  @@map("chain_event_logs")
}

model SyncState {
  id              String   @id
  chainId         Int
  contractAddress String
  lastBlock       BigInt   @default(0)
  lastBlockHash   String?
  updatedAt       DateTime @updatedAt

  @@unique([chainId, contractAddress])
  @@map("sync_states")
}
